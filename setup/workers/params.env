# Worker MachineSet defaults — override with environment variables before running install.sh
# Untainted workers host kube-burner / KubeVirt load-test VMs.
#
# Default: AMD EPYC memory-optimized, 32 vCPU / 256 GiB, nested virt supported
#   https://learn.microsoft.com/en-us/azure/virtual-machines/sizes/memory-optimized/easv6-series
# Example: WORKER_VM_SIZE=Standard_E32ads_v6 WORKER_REPLICAS=1 ./setup/workers/install.sh

WORKER_VM_SIZE=Standard_E32ds_v6
WORKER_REPLICAS=1
