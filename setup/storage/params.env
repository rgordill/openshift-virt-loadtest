# ODF storage node defaults — override with environment variables before running install.sh
# ODF requires ≥30 CPUs + 72 GiB RAM across 3 nodes → Standard_D16s_v3 (16 vCPU, 64 GiB each)

ODF_VM_SIZE=Standard_D16s_v6
ODF_REPLICAS=1

# Azure disk SKU for OSD backing StorageClass managed-csi-v2 (Premium SSD v2)
ODF_DISK_SKU=PremiumV2_LRS
ODF_OSD_STORAGE_CLASS=managed-csi-v2
